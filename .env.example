# LLM API 配置
# 当前版本使用校内 OpenAI 兼容服务。
LLM_PROVIDER=openai
OPENAI_API_KEY=your_school_api_key_here
OPENAI_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
OPENAI_MODEL=ecnu-max
# 切换到 DeepSeek 时设置 LLM_PROVIDER=deepseek，并填写以下密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 服务配置
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./echo.db
CORS_ORIGINS=http://localhost:5173
