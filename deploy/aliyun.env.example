# 复制为 deploy/aliyun.env；不要上传填好的文件。
# 本地验证使用 http://localhost；备案完成后改为实际域名，如 maybe.example.com。
SITE_ADDRESS=http://localhost
PUBLIC_ORIGIN=http://localhost
HTTP_PORT=80
HTTPS_PORT=443

# 校内服务，密钥只传给后端容器。
LLM_PROVIDER=openai
OPENAI_API_KEY=replace_with_your_school_api_key
OPENAI_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
OPENAI_MODEL=ecnu-max

# 使用 DeepSeek 时改为 LLM_PROVIDER=deepseek，并填写以下密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 备案成功后填写实际备案号，修改后重新构建 web。
VITE_ICP_RECORD=

# 镜像仓库地址可按阿里云控制台提供的官方加速配置调整。
PYTHON_IMAGE=python:3.11-slim
NODE_IMAGE=node:24-alpine
CADDY_IMAGE=caddy:2-alpine
PIP_INDEX_URL=https://pypi.org/simple
